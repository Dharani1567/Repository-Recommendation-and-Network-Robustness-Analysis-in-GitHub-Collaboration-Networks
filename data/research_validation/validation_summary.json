  "findings_summary": {
    "correlation_discrepancy_resolved": "Near-perfect correlation (rho ~ 0.998) was caused by 4,197 degree-1 leaf nodes (88.2% of dataset) sharing identical tied minimum ranks. Among 562 multi-repo contributors, Degree vs Betweenness drops to rho = 0.5245 and Betweenness vs K-Core drops to rho = 0.3454.",
    "zero_valid_recommendations_resolved": "Not a software defect. Under 5% targeted degree removal (238 nodes), every contributor with degree > 1 in the training graph is eliminated. Co-occurrence matrix becomes identically zero, making CF mathematically unable to score items.",
    "cohort_drift_resolved": "Matched baselines successfully calculated for all survivor cohorts. Under 1% degree removal, the matched baseline was 38.91% (true drop = -28.99%)."
  }
